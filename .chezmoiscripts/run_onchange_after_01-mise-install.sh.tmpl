#!/usr/bin/env bash
set -euo pipefail

# config.toml hash:       {{ include "dot_config/mise/config.toml" | sha256sum }}
# config.work.toml hash:  {{ include "dot_config/mise/config.work.toml" | sha256sum }}
# config.home.toml hash:  {{ include "dot_config/mise/config.home.toml" | sha256sum }}
# config.other.toml hash: {{ include "dot_config/mise/config.other.toml" | sha256sum }}

export PATH="$HOME/.local/bin:$PATH"

# Install the shared tools plus this machine's environment overlay.
export MISE_ENV="{{ .environment }}"

if ! command -v mise &>/dev/null; then
    echo "==> mise not found, skipping tool installation."
    exit 0
fi

# Most tools are GitHub-release/aqua based. Without a token, mise uses the
# unauthenticated GitHub API (60 req/hr) and fails with 403 rate-limit errors.
# Pull a token from the gh CLI if one isn't already set. (At this point mise
# isn't activated yet, so `gh` resolves to the system/snap gh, not mise's.)
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh &>/dev/null; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    [ -n "${GITHUB_TOKEN}" ] && export GITHUB_TOKEN
fi

echo "==> Running mise install for environment '${MISE_ENV}' (this may take a while)..."
mise install -y

echo "==> Installing pip-based tools..."
if command -v mise &>/dev/null; then
    eval "$(mise activate bash)"

    # bpytop - resource monitor
    if command -v pip &>/dev/null; then
        pip install --user bpytop 2>/dev/null || true
    fi

    # npm-based tools
    if command -v npm &>/dev/null; then
        echo "    Installing tldr..."
        npm install -g tldr 2>/dev/null || true
    fi

    # Go-based tools
    if command -v go &>/dev/null; then
        echo "    Installing sqltui..."
        go install github.com/nicktrav/sqltui@latest 2>/dev/null || true

        echo "    Installing lazyworktree..."
        go install github.com/chmouel/lazyworktree/cmd/lazyworktree@latest 2>/dev/null || true
    fi

    # gh extensions
    if command -v gh &>/dev/null; then
        if ! gh extension list 2>/dev/null | grep -q "dlvhdr/gh-dash"; then
            echo "    Installing gh-dash..."
            gh extension install dlvhdr/gh-dash 2>/dev/null || true
        fi
    fi
fi

echo "==> mise tools installed."
