#!/usr/bin/env bash
set -euo pipefail

# package.toml hash: {{ include "dot_config/yazi/package.toml" | sha256sum }}

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise &>/dev/null; then
    exit 0
fi

eval "$(mise activate bash)"

if ! command -v ya &>/dev/null; then
    echo "==> ya (yazi) not found, skipping plugin install."
    exit 0
fi

echo "==> Installing yazi plugins..."
ya pkg add wylie102/duckdb 2>/dev/null || true

# yazi >= 26.x removed `ya pkg install --discard`. Without it, install aborts when a
# deployed plugin's files differ from its recorded hash ("locally modified"). These
# plugins are managed, not hand-edited, so delete the deployed dirs first and let
# install redeploy them cleanly — reproducing the old --discard behavior.
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/plugins"
pkg_toml="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/package.toml"
if [ -f "$pkg_toml" ]; then
    grep -oP '^\s*use\s*=\s*"\K[^"]+' "$pkg_toml" | while read -r use; do
        rm -rf "$plugins_dir/${use##*/}.yazi"
    done
fi

ya pkg install

echo "==> Yazi plugins installed."
