#!/usr/bin/env bash
set -euo pipefail

# package.toml hash: {{ include "dot_config/yazi/package.toml" | sha256sum }}

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise &>/dev/null; then
    exit 0
fi

eval "$(mise activate bash)"

if ! command -v ya &>/dev/null; then
    echo "==> ya (yazi) not found, skipping plugin install."
    exit 0
fi

echo "==> Installing yazi plugins..."
ya pkg add wylie102/duckdb 2>/dev/null || true
# --discard: yazi aborts if a deployed plugin's files differ from its recorded
# hash (it treats them as "locally modified"). The plugins are managed, not
# hand-edited, so discard and redeploy cleanly instead of failing the apply.
ya pkg install --discard

echo "==> Yazi plugins installed."
