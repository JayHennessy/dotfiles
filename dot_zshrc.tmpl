# ~/.zshrc - managed by chezmoi

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Path
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"

# oh-my-zsh
if [ -d "$HOME/.oh-my-zsh" ]; then
    export ZSH="$HOME/.oh-my-zsh"
    ZSH_THEME="robbyrussell"
    plugins=(git extract copypath copyfile zsh-autosuggestions zsh-syntax-highlighting)
    source "$ZSH/oh-my-zsh.sh"
fi

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=20000
setopt appendhistory
setopt hist_ignore_dups
setopt hist_ignore_space

# mise environment (work/home/other) - selected at chezmoi init.
# Controls which config.<env>.toml overlay mise merges on top of config.toml.
export MISE_ENV="{{ .environment }}"

# mise
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# fzf
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh)"
fi

# zoxide
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# television (tv) — must come after fzf so it wins the Ctrl-R binding
if command -v tv &>/dev/null; then
    eval "$(tv init zsh)"
    # Keep Ctrl-T on fzf's file widget; tv owns Ctrl-R (history) only
    bindkey '^T' fzf-file-widget

    # wt: fuzzy-find a git worktree (tv 'worktrees' channel) and cd into it
    wt() {
        local dir
        dir=$(tv worktrees) || return
        [[ -n "$dir" && -d "$dir" ]] && builtin cd -- "$dir"
    }
    # Alt-w keybind: launch the worktree picker from the prompt
    # (requires Warp's voice_input_toggle_key = "alt_left" to be disabled)
    _tv_worktree_widget() { wt; zle reset-prompt; }
    zle -N _tv_worktree_widget
    bindkey '^[w' _tv_worktree_widget
fi

# Aliases
if command -v nvim &>/dev/null; then
    alias vim='nvim'
    alias vi='nvim'
    export EDITOR='nvim'
    export VISUAL='nvim'
fi

if command -v lazygit &>/dev/null; then
    alias lg='lazygit'
fi

if command -v lazydocker &>/dev/null; then
    alias ld='lazydocker'
fi

if command -v k9s &>/dev/null; then
    alias k='k9s'
fi

if command -v lazyworktree &>/dev/null; then
    alias lw='lazyworktree'
    # lwcd: run lazyworktree TUI and cd into selected worktree on exit
    lwcd() {
        local sel
        sel=$(mktemp) || return 1
        lazyworktree --output-selection "$sel" "$@"
        local rc=$?
        if [[ -s "$sel" ]]; then
            local target
            target=$(<"$sel")
            [[ -d "$target" ]] && cd "$target"
        fi
        rm -f "$sel"
        return $rc
    }
fi

if command -v yazi &>/dev/null; then
    alias y='yazi'
fi

if command -v aws-vault &>/dev/null; then
    alias av='aws-vault'
fi

if command -v nvim &>/dev/null; then
    alias nv='nvim'
fi

if command -v claude &>/dev/null; then
    alias cc='claude'
fi

alias cm='chezmoi'

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# yy - yazi with directory change on exit
yy() {
    local tmp
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd" || return
    fi
    rm -f -- "$tmp"
}

# Source local overrides (not managed by chezmoi)
if [ -f "$HOME/.zshrc.local" ]; then
    . "$HOME/.zshrc.local"
fi
