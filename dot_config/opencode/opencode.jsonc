{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode 2 plugin API. oh-my-openagent remains configured in
  // oh-my-openagent.json for a future migration, but cannot load on V2 yet.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    // V1-only at the time of migration (V2 fails to load these modules):
    // "opencode-caveman",
    // "openrtk",
    // "openslimedit@latest",
    "@dietrichgebert/ponytail",
    // "opencode-tool-search", // locally disabled before the V2 migration
    "@ephemushroom/opencode-claude-mem@0.6.2"
  ],
  // Route the OpenCode Zen provider through the local headroom proxy so ALL
  // opencode traffic is auto-compressed before reaching Zen. Requires the
  // headroom-proxy systemd --user service to be running (home env only). If the
  // proxy is down, opencode can't reach Zen — check `systemctl --user status
  // headroom-proxy`. Proxy upstream is set to https://opencode.ai/zen/v1.
  "providers": {
    "opencode": {
      "settings": { "baseURL": "http://127.0.0.1:8787/v1" }
    }
  }
}
